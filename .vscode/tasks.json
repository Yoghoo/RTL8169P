{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build (wmake)",
            "type": "process",
            "command": "powershell",
            "args": ["-NoProfile", "-Command", "wmake clean; wmake"],
            "options": {
                "cwd": "${workspaceFolder}/src"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": {
                "owner": "watcom-c",
                "fileLocation": ["relative", "${workspaceFolder}/src"],
                "pattern": {
                    "regexp": "^(.*)\\((\\d+)\\):\\s+(Error|Warning)!\\s+(\\w+):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "severity": 3,
                    "code": 4,
                    "message": 5
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "detail": "Runs 'wmake clean' first, then 'wmake' - builds RTL8169P.EXE, RTLDEBUG.EXE, and RTL8169P.ZIP via src/Makefile. Always cleans first since wmake's timestamp-based staleness check can be unreliable on network drives. Requires Open Watcom v2 (wcl/wmake) on PATH - see README.md."
        },
        {
            "label": "Clean (wmake clean)",
            "type": "shell",
            "command": "wmake clean",
            "options": {
                "cwd": "${workspaceFolder}/src"
            },
            "group": "build",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "detail": "Removes built .obj/.exe/.zip files."
        }
    ]
}
